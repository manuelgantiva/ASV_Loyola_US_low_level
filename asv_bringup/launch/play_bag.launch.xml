<launch>

   <arg name="bag_name" default="default_bag" />

  <executable
    cmd="ros2 topic pub --once /ASV3/mavros/state mavros_msgs/msg/State '{armed: true}'"
    output="screen"/>

  <executable
    cmd="ros2 bag play $(var bag_name) --topics /ASV3/comunication/imu_ext/data /ASV3/mavros/global_position/compass_hdg /ASV3/mavros/global_position/global /ASV3/mavros/global_position/local /ASV3/mavros/imu/data /ASV3/mavros/imu/data_raw /ASV3/mavros/local_position/pose /ASV3/mavros/local_position/velocity_body /ASV3/mavros/local_position/velocity_local /ASV3/mavros/rc/in /ASV3/mavros/rc/out /ASV3/mavros/rc/override /ASV3/mavros/setpoint_velocity/cmd_vel_unstamped"
    
    output="screen" />

</launch>